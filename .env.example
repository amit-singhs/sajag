# Copy to .env at the repository root (both apps read it locally). Never commit .env.

# --- API (Render) ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (add your Vercel domains in production)
WEB_ORIGINS=http://localhost:5173

# Azure SQL Database — paste the portal string as-is (ODBC / ADO.NET) or use sqlserver://… form
DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=<database>;user=<user>;password=<password>;encrypt=true;trustServerCertificate=false;loginTimeout=30"

# Azure DocumentDB (MongoDB vCore) — campaign/form definitions
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000"
MONGODB_DB=sajag

# Security — generate with: openssl rand -hex 32  /  openssl rand -base64 32
JWT_SECRET=
DATA_ENCRYPTION_KEY=
HASH_PEPPER=

# First admin, created automatically on the first `db:deploy` / server start when no admin exists
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrator
SEED_SAMPLE_CAMPAIGN=true

# SMS: console (dev — OTP printed in API log) | msg91
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_ERASURE_TEMPLATE_ID=

# DigiLocker partner credentials (integration not built yet)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# Shown in the privacy notice (DPDP Rules, rule 9)
ORG_NAME=सजग
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# --- Web (Vercel) ---
# Leave empty locally (Vite proxies /api to the local API). On Vercel: https://<your-api>.onrender.com
VITE_API_URL=
