{
  "name": "@sajag/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx scripts/with-env.ts tsx watch src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "tsx scripts/with-env.ts prisma migrate deploy",
    "db:deploy": "tsx scripts/with-env.ts 'prisma migrate deploy && npm run db:check && node dist/deploy.js'",
    "db:check": "tsx scripts/with-env.ts 'prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code > /dev/null || (echo \"Schema drift: prisma/schema.prisma changed without a migration. Run: npm run db:migration -- <name>\" && exit 1)'",
    "db:migration": "tsx scripts/with-env.ts tsx scripts/new-migration.ts",
    "jobs:retention": "tsx scripts/with-env.ts node dist/jobs/retention.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sajag/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
